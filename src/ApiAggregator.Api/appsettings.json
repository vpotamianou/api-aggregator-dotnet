{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ApiAggregator",
    "Audience": "ApiAggregator.Clients",
    "SigningKey": "a1b2c3d4-e5f6-7890-abcd-ef1234567890-uwwmddkff454",
    "ExpirationMinutes": 60,
    "DemoUsername": "demo",
    "DemoPassword": "demo123"
  },
  "Cache": {
    "AggregatedTtlSeconds": 60,
    "FallbackTtlSeconds": 3600
  },
  "Statistics": {
    "FastThresholdMs": 100,
    "SlowThresholdMs": 200
  },
  "ExternalApis": {
    "Weather": {
      "BaseUrl": "https://api.openweathermap.org/",
      "ApiKey": "REPLACE_WITH_OPENWEATHERMAP_KEY",
      "DefaultCity": "Athens",
      "TimeoutSeconds": 5
    },
    "News": {
      "BaseUrl": "https://newsapi.org/",
      "ApiKey": "REPLACE_WITH_NEWSAPI_KEY",
      "DefaultQuery": "technology",
      "PageSize": 20,
      "TimeoutSeconds": 5
    },
    "GitHub": {
      "BaseUrl": "https://api.github.com/",
      "DefaultQuery": "stars:>10000",
      "PageSize": 10,
      "TimeoutSeconds": 5,
      "UserAgent": "ApiAggregator/1.0"
    }
  }
}
